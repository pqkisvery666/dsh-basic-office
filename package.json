{
  "name": "dsh-basic-office",
  "version": "0.1.0",
  "description": "DSH 办公文件插件：阅读 PDF/DOCX/XLSX/PPTX 等常见二进制文档，生成 DOCX/XLSX/PPTX/PDF/CSV 等常见文件。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "office",
    "pdf",
    "docx",
    "xlsx",
    "pptx"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./lib/generators.js": "./lib/generators.js",
    "./lib/parsers.js": "./lib/parsers.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dependencies": {
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "pdfkit": "^0.19.1",
    "pptxgenjs": "^4.0.1",
    "unpdf": "^1.8.1",
    "xlsx": "^0.18.5"
  }
}
